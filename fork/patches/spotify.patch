index 0000000000000000000000000000000000000000..6efd5cc70aeab9839d3fbbd3ae85c5a33747bdb1
--- /dev/null
+++ b/src/spotify_compat.rs
@@ -0,0 +1,165 @@
+//! Local Spotify Apple Events, handled inside the player process.
+//!
+//! The original profile, credential service and instance slot are unchanged.
+//! No timers, child processes, network requests or extra artwork cache.
+
+use crate::single_instance::ControlCommand;
+
+#[cfg(any(target_os = "macos", test))]
+pub mod cli;
+
+pub const DISPLAY_NAME: &str = if cfg!(target_os = "macos") {
+    "Spotify"
+} else {
+    "Spotifast"
+};
+pub const UPDATE_REPOSITORY: &str = "Tarx2000/spotifast";
+pub const SOURCE_URL: &str = "https://github.com/Tarx2000/spotifast";
+pub const RELEASES_URL: &str = "https://github.com/Tarx2000/spotifast/releases";
+
+pub const fn code(bytes: &[u8; 4]) -> u32 {
+    u32::from_be_bytes(*bytes)
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Snapshot {
+    pub uri: String,
+    pub title: String,
+    pub artist: String,
+    pub album: String,
+    pub artwork_url: String,
+    pub duration_ms: u32,
+    pub position_ms: u32,
+    pub volume: u8,
+    pub playing: bool,
+    pub shuffle: bool,
+    pub repeating: bool,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Value {
+    Text(String),
+    Integer(i32),
+    Real(f64),
+    Boolean(bool),
+    Enum(u32),
+    Track,
+    Missing,
+}
+
+impl Snapshot {
+    pub fn read(&self, property: u32, track: bool) -> Option<Value> {
+        use Value::*;
+        if track {
+            if self.uri.is_empty() {
+                return Some(Missing);
+            }
+            return Some(match property {
+                p if p == code(b"pnam") => Text(self.title.clone()),
+                p if p == code(b"pArt") => Text(self.artist.clone()),
+                p if p == code(b"pAlb") => Text(self.album.clone()),
+                p if p == code(b"pDur") => Integer(self.duration_ms.min(i32::MAX as u32) as i32),
+                p if p == code(b"ID  ") => Text(self.uri.clone()),
+                p if p == code(b"sUrl") => Text(self.uri.clone()),
+                p if p == code(b"aUrl") => Text(self.artwork_url.clone()),
+                _ => return None,
+            });
+        }
+        Some(match property {
+            p if p == code(b"pnam") => Text(DISPLAY_NAME.into()),
+            p if p == code(b"vers") => Text(env!("CARGO_PKG_VERSION").into()),
+            p if p == code(b"pTrk") => {
+                if self.uri.is_empty() {
+                    Missing
+                } else {
+                    Track
+                }
+            }
+            p if p == code(b"pVol") => Integer(i32::from(self.volume)),
+            p if p == code(b"pPos") => Real(f64::from(self.position_ms) / 1000.0),
+            p if p == code(b"pPlS") => Enum(if self.uri.is_empty() {
+                code(b"kPSS")
+            } else if self.playing {
+                code(b"kPSP")
+            } else {
+                code(b"kPSp")
+            }),
+            p if p == code(b"pShf") => Boolean(self.shuffle),
+            p if p == code(b"pRpt") => Boolean(self.repeating),
+            p if p == code(b"pShE") || p == code(b"pRpE") => Boolean(true),
+            _ => return None,
+        })
+    }
+}
+
+pub fn numeric_command(property: u32, value: f64) -> Option<ControlCommand> {
+    if !value.is_finite() {
+        return None;
+    }
+    if property == code(b"pVol") && (0.0..=100.0).contains(&value) {
+        Some(ControlCommand::SetVolume(value.round() as u8))
+    } else if property == code(b"pPos") && (0.0..=f64::from(u32::MAX) / 1000.0).contains(&value) {
+        Some(ControlCommand::SeekTo((value * 1000.0).round() as u32))
+    } else {
+        None
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod native;
+#[cfg(target_os = "macos")]
+pub use native::{install, update};
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spotify_units_and_track_identity_come_from_the_live_player() {
+        let s = Snapshot {
+            uri: "spotify:track:test".into(),
+            duration_ms: 120_123,
+            position_ms: 12_345,
+            volume: 37,
+            playing: true,
+            ..Snapshot::default()
+        };
+        assert_eq!(s.read(code(b"pPos"), false), Some(Value::Real(12.345)));
+        assert_eq!(s.read(code(b"pDur"), true), Some(Value::Integer(120_123)));
+        assert_eq!(
+            s.read(code(b"ID  "), true),
+            Some(Value::Text(s.uri.clone()))
+        );
+        assert_eq!(
+            s.read(code(b"pPlS"), false),
+            Some(Value::Enum(code(b"kPSP")))
+        );
+        assert_eq!(
+            numeric_command(code(b"pPos"), 12.345),
+            Some(ControlCommand::SeekTo(12_345))
+        );
+    }
+
+    #[test]
+    fn invalid_setters_and_missing_tracks_do_not_invent_state() {
+        for value in [f64::NAN, f64::INFINITY, -1.0, 101.0] {
+            assert!(numeric_command(code(b"pVol"), value).is_none());
+        }
+        assert!(numeric_command(code(b"pPos"), f64::MAX).is_none());
+        assert_eq!(
+            Snapshot::default().read(code(b"pTrk"), false),
+            Some(Value::Missing)
+        );
+        assert_eq!(
+            Snapshot::default().read(code(b"pPlS"), false),
+            Some(Value::Enum(code(b"kPSS")))
+        );
+        assert_eq!(Snapshot::default().read(code(b"nope"), false), None);
+    }
+
+    #[test]
+    fn updates_are_always_from_the_personal_channel() {
+        assert_eq!(crate::updates::CONFIG.repository, UPDATE_REPOSITORY);
+        assert_ne!(UPDATE_REPOSITORY, "crmne/spotifast");
+    }
+}
diff --git a/src/spotify_compat/cli.rs b/src/spotify_compat/cli.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fb7ba784bf5e6569dd5bf035cd688ec6915b0364
--- /dev/null
+++ b/src/spotify_compat/cli.rs
@@ -0,0 +1,260 @@
+//! The small subset of Spotify's bundled CLI that Canopy uses for its heart.
+//!
+//! `spotify_cli` is a relative link to the player executable. This entry point
+//! exits before starting a window, backend, account, or second player. It only
+//! talks to the existing per-user control channel.
+
+use std::ffi::OsString;
+use std::io::Write;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use serde_json::{Value, json};
+
+use crate::single_instance::{self, Reply};
+
+#[derive(Debug, PartialEq)]
+enum Command {
+    NowPlaying,
+    Contains(String),
+    Save { uri: String, saved: bool },
+}
+
+fn parse(args: &[String]) -> Result<Command, &'static str> {
+    if args.len() > 12 || args.iter().any(|s| s.len() > 256) {
+        return Err("Too many or oversized CLI arguments.");
+    }
+    let mut positional = Vec::new();
+    let mut args = args.iter();
+    while let Some(argument) = args.next() {
+        if argument == "--format" {
+            if args.next().map(String::as_str) != Some("json") {
+                return Err("The personal Spotify CLI supports JSON output.");
+            }
+        } else if argument == "--format=json" {
+            continue;
+        } else {
+            positional.push(argument.as_str());
+        }
+    }
+    match positional.as_slice() {
+        ["now-playing"] => Ok(Command::NowPlaying),
+        ["library", verb, uri] => {
+            let uri = single_instance::spotify_track_uri(uri)
+                .ok_or("A canonical Spotify track URI is required.")?;
+            match *verb {
+                "contains" => Ok(Command::Contains(uri)),
+                "add" => Ok(Command::Save { uri, saved: true }),
+                "remove" => Ok(Command::Save { uri, saved: false }),
+                _ => Err("Unsupported library command."),
+            }
+        }
+        _ => {
+            Err("Supported: now-playing; library contains/add/remove <track URI> [--format json].")
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Track {
+    uri: String,
+    title: String,
+    artist: String,
+    album: String,
+    position_ms: u32,
+    duration_ms: u32,
+    playing: bool,
+    saved: Option<bool>,
+}
+
+impl Track {
+    fn from_snapshot(snapshot: &str) -> Result<Option<Self>, &'static str> {
+        if snapshot == single_instance::NOTHING_PLAYING {
+            return Ok(None);
+        }
+        let fields: Vec<_> = snapshot.split('\t').collect();
+        if fields.len() < 13 {
+            return Err("Restart the updated Spotify app before using its CLI.");
+        }
+        Ok(Some(Self {
+            uri: single_instance::spotify_track_uri(fields[12])
+                .ok_or("The current item is not a Spotify track.")?,
+            title: fields[1].to_owned(),
+            artist: fields[2].to_owned(),
+            album: fields[3].to_owned(),
+            position_ms: fields[4].parse().map_err(|_| "Invalid player position.")?,
+            duration_ms: fields[5].parse().map_err(|_| "Invalid track duration.")?,
+            playing: fields[0] == "playing",
+            saved: match fields[10] {
+                "yes" => Some(true),
+                "no" => Some(false),
+                _ => None,
+            },
+        }))
+    }
+
+    fn contains(&self, uri: &str) -> Result<bool, &'static str> {
+        if self.uri != uri {
+            return Err("This compatibility CLI only exposes the current track.");
+        }
+        self.saved
+            .ok_or("The player's saved state is still loading.")
+    }
+
+    fn now_playing(&self) -> Value {
+        json!({
+            "currently_playing": {
+                "uri": self.uri,
+                "name": self.title,
+                "description": format!("{} - {}", self.title, self.artist),
+                "artists": [{"name": self.artist}],
+                "album": {"name": self.album},
+                "duration_ms": self.duration_ms,
+                "is_saved": self.saved,
+            },
+            "is_playing": self.playing,
+            "progress_ms": self.position_ms,
+        })
+    }
+}
+
+fn current() -> anyhow::Result<Option<Track>> {
+    let Reply::NowPlaying(snapshot) = single_instance::send("nowplaying")? else {
+        anyhow::bail!("The player did not return a track snapshot.");
+    };
+    Track::from_snapshot(&snapshot).map_err(anyhow::Error::msg)
+}
+
+fn execute(command: Command) -> anyhow::Result<Value> {
+    if command == Command::NowPlaying {
+        return Ok(current()?.map_or_else(
+            || json!({"currently_playing": null, "is_playing": false}),
+            |track| track.now_playing(),
+        ));
+    }
+    let track = current()?.ok_or_else(|| anyhow::anyhow!("No track is playing."))?;
+    match command {
+        Command::Contains(uri) => {
+            let saved = track.contains(&uri).map_err(anyhow::Error::msg)?;
+            Ok(json!({"contains": {uri: saved}}))
+        }
+        Command::Save { uri, saved } => {
+            if track.uri != uri {
+                anyhow::bail!("The current track changed. No library change was sent.");
+            }
+            if track.saved == Some(saved) {
+                return Ok(json!({"success": true}));
+            }
+            let state = if saved { "on" } else { "off" };
+            if !matches!(
+                single_instance::send(&format!("save-set {state} {uri}"))?,
+                Reply::Ok
+            ) {
+                anyhow::bail!("The player did not accept the library command.");
+            }
+            // A short command waits for the player's optimistic state. There is
+            // no polling service; this process exits after the explicit click.
+            let deadline = Instant::now() + Duration::from_secs(2);
+            while Instant::now() < deadline {
+                if let Some(track) = current()?
+                    && track.uri == uri
+                    && track.saved == Some(saved)
+                {
+                    return Ok(json!({"success": true}));
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            anyhow::bail!("The player has not reflected the library command yet.");
+        }
+        Command::NowPlaying => unreachable!(),
+    }
+}
+
+/// `None` leaves an ordinary player or Spotifast control launch unchanged.
+pub fn run_if_cli(arguments: impl IntoIterator<Item = OsString>) -> Option<i32> {
+    let mut arguments = arguments.into_iter();
+    let program = arguments.next()?;
+    if Path::new(&program).file_name()? != "spotify_cli" {
+        return None;
+    }
+    let result = arguments
+        .map(|arg| {
+            arg.into_string()
+                .map_err(|_| anyhow::anyhow!("Arguments must be UTF-8."))
+        })
+        .collect::<anyhow::Result<Vec<_>>>()
+        .and_then(|args| parse(&args).map_err(anyhow::Error::msg))
+        .and_then(execute);
+    Some(match result {
+        Ok(value) => i32::from(writeln!(std::io::stdout().lock(), "{value}").is_err()),
+        Err(error) => {
+            let _ = writeln!(
+                std::io::stderr().lock(),
+                "Spotify compatibility CLI: {error}"
+            );
+            1
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(values: &[&str]) -> Vec<String> {
+        values.iter().map(|value| (*value).to_owned()).collect()
+    }
+
+    #[test]
+    fn canopy_commands_accept_json_flags_and_reject_unrelated_or_injected_requests() {
+        assert_eq!(
+            parse(&args(&["--format", "json", "now-playing"])),
+            Ok(Command::NowPlaying)
+        );
+        assert_eq!(
+            parse(&args(&[
+                "library",
+                "contains",
+                "spotify:track:abc",
+                "--format=json"
+            ])),
+            Ok(Command::Contains("spotify:track:abc".into()))
+        );
+        for verb in ["add", "remove"] {
+            assert_eq!(
+                parse(&args(&["library", verb, "spotify:track:abc"])),
+                Ok(Command::Save {
+                    uri: "spotify:track:abc".into(),
+                    saved: verb == "add"
+                })
+            );
+        }
+        for request in [
+            vec!["library", "add", "spotify:track:abc\nnext"],
+            vec!["library", "remove", "spotify:playlist:abc"],
+            vec!["library", "batch"],
+            vec!["now-playing", "--format", "xml"],
+        ] {
+            assert!(parse(&args(&request)).is_err());
+        }
+        assert_eq!(run_if_cli([OsString::from("Spotify")]), None);
+    }
+
+    #[test]
+    fn unknown_or_stale_likes_are_not_reported_as_false() {
+        let snapshot = "paused\tTitle\tArtist\tAlbum\t12000\t200000\t35\toff\toff\t\tunknown\tSpotify\tspotify:track:abc";
+        let track = Track::from_snapshot(snapshot).unwrap().unwrap();
+        assert!(track.contains("spotify:track:abc").is_err());
+        assert!(track.contains("spotify:track:other").is_err());
+        assert_eq!(
+            track.now_playing()["currently_playing"]["uri"],
+            "spotify:track:abc"
+        );
+        assert!(Track::from_snapshot("playing\told snapshot").is_err());
+        assert!(Track::from_snapshot("stopped").unwrap().is_none());
+        let liked = Track::from_snapshot(&snapshot.replace("unknown", "yes"))
+            .unwrap()
+            .unwrap();
+        assert_eq!(liked.contains("spotify:track:abc"), Ok(true));
+    }
+}
diff --git a/src/spotify_compat/native.rs b/src/spotify_compat/native.rs
new file mode 100644
index 0000000000000000000000000000000000000000..91721d8fb661db0cf9302f2ead2cbd8e9f8ee401
--- /dev/null
+++ b/src/spotify_compat/native.rs
@@ -0,0 +1,334 @@
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+use objc2::rc::Retained;
+use objc2::{MainThreadOnly, define_class, msg_send, sel};
+use objc2_foundation::{
+    MainThreadMarker, NSAppleEventDescriptor as Descriptor, NSAppleEventManager, NSDictionary,
+    NSDistributedNotificationCenter, NSObject, NSString,
+};
+
+use super::{Snapshot, Value, code, numeric_command};
+use crate::backend::Waker;
+use crate::player::RepeatMode;
+use crate::single_instance::ControlCommand;
+
+type Sink = (Arc<Mutex<Vec<ControlCommand>>>, Waker);
+static SINK: Mutex<Option<Sink>> = Mutex::new(None);
+static SNAPSHOT: Mutex<Option<Snapshot>> = Mutex::new(None);
+
+fn descriptor_type(value: &Descriptor) -> u32 {
+    unsafe { msg_send![value, descriptorType] }
+}
+
+fn param(event: &Descriptor, key: u32) -> Option<Retained<Descriptor>> {
+    unsafe { msg_send![event, paramDescriptorForKeyword: key] }
+}
+fn field(record: &Descriptor, key: u32) -> Option<Retained<Descriptor>> {
+    unsafe { msg_send![record, descriptorForKeyword: key] }
+}
+fn set_field(record: &Descriptor, key: u32, value: &Descriptor) {
+    unsafe {
+        let _: () = msg_send![record, setDescriptor: value, forKeyword: key];
+    }
+}
+fn reply_value(reply: &Descriptor, key: u32, value: &Descriptor) {
+    unsafe {
+        let _: () = msg_send![reply, setParamDescriptor: value, forKeyword: key];
+    }
+}
+fn error(reply: &Descriptor, number: i32) {
+    reply_value(
+        reply,
+        code(b"errn"),
+        &Descriptor::descriptorWithInt32(number),
+    );
+}
+fn text(value: &str) -> Retained<Descriptor> {
+    Descriptor::descriptorWithString(&NSString::from_str(value))
+}
+
+// Only the application's own property and current-track specifiers are
+// accepted. Never evaluate arbitrary object specifiers or incoming code.
+fn property(specifier: &Descriptor, depth: u8) -> Option<(u32, bool)> {
+    if depth > 3 || descriptor_type(specifier) != code(b"obj ") {
+        return None;
+    }
+    if field(specifier, code(b"want"))?.typeCodeValue() != code(b"prop") {
+        return None;
+    }
+    if field(specifier, code(b"form"))?.enumCodeValue() != code(b"prop") {
+        return None;
+    }
+    let selected = field(specifier, code(b"seld"))?.typeCodeValue();
+    let container = field(specifier, code(b"from"))?;
+    if descriptor_type(&container) == code(b"null") {
+        return Some((selected, false));
+    }
+    let (parent, track) = property(&container, depth + 1)?;
+    (parent == code(b"pTrk") && !track).then_some((selected, true))
+}
+
+fn descriptor(value: Value, state: &Snapshot) -> Retained<Descriptor> {
+    match value {
+        Value::Text(value) => text(&value),
+        Value::Integer(value) => Descriptor::descriptorWithInt32(value),
+        Value::Real(value) => Descriptor::descriptorWithDouble(value),
+        Value::Boolean(value) => Descriptor::descriptorWithBoolean(u8::from(value)),
+        Value::Enum(value) => Descriptor::descriptorWithEnumCode(value),
+        Value::Missing => Descriptor::nullDescriptor(),
+        Value::Track => {
+            let record = Descriptor::recordDescriptor();
+            for key in [
+                code(b"pnam"),
+                code(b"pArt"),
+                code(b"pAlb"),
+                code(b"pDur"),
+                code(b"ID  "),
+                code(b"aUrl"),
+                code(b"sUrl"),
+            ] {
+                if let Some(value) = state.read(key, true) {
+                    set_field(&record, key, &descriptor(value, state));
+                }
+            }
+            record
+        }
+    }
+}
+
+fn enqueue(command: ControlCommand, reply: &Descriptor) {
+    let guard = SINK.lock().unwrap_or_else(|p| p.into_inner());
+    let Some((queue, waker)) = guard.as_ref() else {
+        error(reply, -600);
+        return;
+    };
+    queue
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .push(command);
+    waker.wake();
+}
+
+fn get(event: &Descriptor, reply: &Descriptor) {
+    let Some((key, track)) = param(event, code(b"----")).and_then(|s| property(&s, 0)) else {
+        error(reply, -1728);
+        return;
+    };
+    let guard = SNAPSHOT.lock().unwrap_or_else(|p| p.into_inner());
+    let state = guard.clone().unwrap_or_default();
+    drop(guard);
+    match state.read(key, track) {
+        Some(value) => reply_value(reply, code(b"----"), &descriptor(value, &state)),
+        None => error(reply, -1728),
+    }
+}
+
+fn set(event: &Descriptor, reply: &Descriptor) {
+    let Some((key, false)) = param(event, code(b"----")).and_then(|s| property(&s, 0)) else {
+        error(reply, -1728);
+        return;
+    };
+    let Some(data) = param(event, code(b"data")) else {
+        error(reply, -1701);
+        return;
+    };
+    let kind = descriptor_type(&data);
+    let boolean = key == code(b"pShf") || key == code(b"pRpt");
+    let accepted = if boolean {
+        [code(b"bool"), code(b"true"), code(b"fals")].contains(&kind)
+    } else {
+        [
+            code(b"long"),
+            code(b"shor"),
+            code(b"comp"),
+            code(b"doub"),
+            code(b"sing"),
+            code(b"magn"),
+        ]
+        .contains(&kind)
+    };
+    if !accepted {
+        error(reply, -1700);
+        return;
+    }
+    let command = if boolean {
+        let value = data.booleanValue() != 0;
+        if key == code(b"pShf") {
+            Some(ControlCommand::SetShuffle(value))
+        } else {
+            Some(ControlCommand::SetRepeat(if value {
+                RepeatMode::Context
+            } else {
+                RepeatMode::Off
+            }))
+        }
+    } else {
+        numeric_command(key, data.doubleValue())
+    };
+    match command {
+        Some(command) => enqueue(command, reply),
+        None => error(reply, -1700),
+    }
+}
+
+fn command(event: &Descriptor, reply: &Descriptor) {
+    let id: u32 = unsafe { msg_send![event, eventID] };
+    let command = match id {
+        c if c == code(b"PlPs") => ControlCommand::PlayPause,
+        c if c == code(b"Play") => ControlCommand::Play,
+        c if c == code(b"Paus") => ControlCommand::Pause,
+        c if c == code(b"Next") => ControlCommand::Next,
+        c if c == code(b"Prev") => ControlCommand::Previous,
+        c if c == code(b"PCtx") => {
+            if param(event, code(b"ctxt")).is_some() {
+                error(reply, -1708);
+                return;
+            }
+            let Some(uri) = param(event, code(b"----"))
+                .and_then(|d| d.stringValue())
+                .and_then(|s| crate::link::parse(&s.to_string()))
+            else {
+                error(reply, -1700);
+                return;
+            };
+            ControlCommand::PlayUri(uri)
+        }
+        _ => {
+            error(reply, -1708);
+            return;
+        }
+    };
+    enqueue(command, reply);
+}
+
+define_class!(
+    #[unsafe(super(NSObject))]
+    #[thread_kind = MainThreadOnly]
+    #[name = "PersonalSpotifyEventHandler"]
+    struct Handler;
+    impl Handler {
+        #[unsafe(method(handleGet:withReplyEvent:))]
+        fn handle_get(&self, event: &Descriptor, reply: &Descriptor) { get(event, reply); }
+        #[unsafe(method(handleSet:withReplyEvent:))]
+        fn handle_set(&self, event: &Descriptor, reply: &Descriptor) { set(event, reply); }
+        #[unsafe(method(handleCommand:withReplyEvent:))]
+        fn handle_command(&self, event: &Descriptor, reply: &Descriptor) { command(event, reply); }
+    }
+);
+
+pub fn install(commands: Arc<Mutex<Vec<ControlCommand>>>, waker: Waker) {
+    let Some(mtm) = MainThreadMarker::new() else {
+        return;
+    };
+    *SINK.lock().unwrap_or_else(|p| p.into_inner()) = Some((commands, waker));
+    static INSTALLED: AtomicBool = AtomicBool::new(false);
+    if INSTALLED.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    let handler: Retained<Handler> = unsafe { msg_send![mtm.alloc::<Handler>(), init] };
+    let manager = NSAppleEventManager::sharedAppleEventManager();
+    for (class, id, selector) in [
+        (
+            code(b"core"),
+            code(b"getd"),
+            sel!(handleGet:withReplyEvent:),
+        ),
+        (
+            code(b"core"),
+            code(b"setd"),
+            sel!(handleSet:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"PlPs"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"Play"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"Paus"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"Next"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"Prev"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+        (
+            code(b"spfy"),
+            code(b"PCtx"),
+            sel!(handleCommand:withReplyEvent:),
+        ),
+    ] {
+        unsafe {
+            let _: () = msg_send![&*manager, setEventHandler: &*handler,
+            andSelector: selector, forEventClass: class, andEventID: id];
+        }
+    }
+    std::mem::forget(handler);
+}
+
+pub fn update(state: Snapshot) {
+    if cfg!(test) || SINK.lock().unwrap_or_else(|p| p.into_inner()).is_none() {
+        return;
+    }
+    let mut guard = SNAPSHOT.lock().unwrap_or_else(|p| p.into_inner());
+    let changed = guard.as_ref().is_none_or(|old| {
+        old.uri != state.uri
+            || old.title != state.title
+            || old.artist != state.artist
+            || old.album != state.album
+            || old.artwork_url != state.artwork_url
+            || old.playing != state.playing
+            || old.shuffle != state.shuffle
+            || old.repeating != state.repeating
+            || old.volume != state.volume
+    });
+    if changed {
+        let keys: Vec<_> = ["Player State", "Name", "Artist", "Album", "Track ID"]
+            .map(NSString::from_str)
+            .into();
+        let playback = if state.uri.is_empty() {
+            "Stopped"
+        } else if state.playing {
+            "Playing"
+        } else {
+            "Paused"
+        };
+        let values: Vec<_> = [
+            playback,
+            &state.title,
+            &state.artist,
+            &state.album,
+            &state.uri,
+        ]
+        .map(NSString::from_str)
+        .into();
+        let dictionary = NSDictionary::from_slices(
+            &keys.iter().map(|v| &**v).collect::<Vec<_>>(),
+            &values.iter().map(|v| &**v).collect::<Vec<_>>(),
+        );
+        // Notification APIs erase dictionary generics; keys and values are immutable NSString objects.
+        let dictionary: Retained<NSDictionary> = unsafe { Retained::cast_unchecked(dictionary) };
+        unsafe {
+            NSDistributedNotificationCenter::defaultCenter()
+                .postNotificationName_object_userInfo_deliverImmediately(
+                    &NSString::from_str("com.spotify.client.PlaybackStateChanged"),
+                    None,
+                    Some(&dictionary),
+                    true,
+                );
+        }
+    }
+    *guard = Some(state);
+}
