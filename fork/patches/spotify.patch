diff --git a/src/app.rs b/src/app.rs
index e3f93e492571f3a6b0af9765b81e94b6dc75aafe..70f079a480c86a4282dd688352b0ce6440a31de0 100644
--- a/src/app.rs
+++ b/src/app.rs
@@ -776,7 +776,7 @@ const RECENTS_PAGE: u32 = 50;
 /// Who the desktop's media controls belong to. Links to Spotify, as
 /// `spotify:` URIs or web addresses, are what they may ask Spotifast to open.
 fn media_app() -> fastframe_now_playing::App {
-    let mut app = fastframe_now_playing::App::new("spotifast", "Spotifast");
+    let mut app = fastframe_now_playing::App::new("spotifast", crate::spotify_compat::DISPLAY_NAME);
     app.uri_schemes = vec!["spotify".into(), "https".into(), "http".into()];
     app
 }
@@ -889,7 +889,7 @@ fn tray_config() -> fastframe_tray::Config {
     use fastframe_tray::MenuItem;
     fastframe_tray::Config {
         id: "spotifast",
-        title: "Spotifast".into(),
+        title: crate::spotify_compat::DISPLAY_NAME.into(),
         icon: util::app_icon_rgba,
         template_icon: Some(util::tray_template_rgba),
         themed_icon: true,
@@ -4374,6 +4374,14 @@ impl App {
                 ControlCommand::ToggleSaved => {
                     self.now_playing().map(|now| Action::ToggleSaved(now.uri))
                 }
+                ControlCommand::SetSaved { uri, saved } => Some(Action::SetSavedMany {
+                    uris: if saved {
+                        vec![uri]
+                    } else {
+                        self.saved_toggle_targets(&uri)
+                    },
+                    saved,
+                }),
                 ControlCommand::PlayUri(uri) => Some(Action::PlayContext {
                     uri,
                     offset_uri: None,
@@ -4544,6 +4552,8 @@ impl App {
                 ..MediaState::default()
             },
         };
+        #[cfg(target_os = "macos")]
+        crate::spotify_compat::update(self.spotify_snapshot());
         if let Some(controls) = &mut self.media_controls {
             controls.update(state);
         }
@@ -4573,9 +4583,29 @@ impl App {
         }
     }
 
+    #[cfg(target_os = "macos")]
+    fn spotify_snapshot(&self) -> crate::spotify_compat::Snapshot {
+        let Some(now) = self.now_playing() else {
+            return crate::spotify_compat::Snapshot::default();
+        };
+        crate::spotify_compat::Snapshot {
+            uri: now.uri,
+            title: now.title,
+            artist: now.subtitle,
+            album: now.album_name,
+            artwork_url: now.art_url.unwrap_or_default(),
+            duration_ms: now.duration_ms,
+            position_ms: now.position_ms,
+            volume: now.volume_percent,
+            playing: now.playing,
+            shuffle: now.shuffle,
+            repeating: now.repeat != RepeatMode::Off,
+        }
+    }
+
     /// One line for the control channel's `nowplaying` verb: tab-separated
     /// `state, title, artists, album, position_ms, duration_ms, volume,
